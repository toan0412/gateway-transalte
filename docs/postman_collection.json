{
  "info": {
    "name": "Translate Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8787"
    },
    {
      "key": "gatewayKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Translate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/translate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "translate"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{gatewayKey}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"texts\": [\n    \"Hello world\",\n    \"How are you?\"\n  ],\n  \"source\": \"auto\",\n  \"target\": \"vi\",\n  \"provider\": null,\n  \"noCache\": false\n}"
        }
      }
    },
    {
      "name": "Translate (ép provider)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/translate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "translate"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{gatewayKey}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"texts\": [\n    \"Hello\"\n  ],\n  \"target\": \"vi\",\n  \"provider\": \"mymemory\"\n}"
        }
      }
    },
    {
      "name": "Providers",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/providers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "providers"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{gatewayKey}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Languages",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/languages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "languages"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{gatewayKey}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}